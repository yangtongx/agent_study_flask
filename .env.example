# ===== LLM (DeepSeek) =====
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# ===== Agent =====
AGENT_MAX_ITERATIONS=10
AGENT_MEMORY_WINDOW=20
AGENT_DEBUG=true

# ===== Database (PostgreSQL) =====
PG_URI=postgresql://user:password@localhost:5432/agent_study

# ===== Vector Store (可选) =====
CHROMA_PERSIST_PATH=./data/chroma

# ===== LangSmith（可选：在网页上看 perceive / decide / act）=====
# 1. 打开 https://smith.langchain.com 注册
# 2. Settings → API Keys 新建一把 Key
# 3. 把下面改成 true，填入 Key，重启 python server.py
# 4. 再发一轮 /chat，到网页左侧项目 agent-study-flask 里点那条 Trace
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-study-flask
# 账号若在欧盟，取消下一行注释：
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
