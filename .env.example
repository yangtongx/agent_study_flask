# ===== LLM (DeepSeek) =====
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# ===== Agent =====
AGENT_MAX_ITERATIONS=10
AGENT_MEMORY_WINDOW=20
AGENT_DEBUG=true
# handmade = 手写 ReAct（默认，测试用假 LLM）
# agentscope = AgentScope 2.0 官方 Agent + 原生 tool calling
AGENT_BACKEND=handmade

# ===== RAG =====
RAG_TOP_K=3
RAG_PERSIST_PATH=./data/rag
RAG_KNOWLEDGE_DIR=./data/knowledge

# ===== Database (PostgreSQL) =====
PG_URI=postgresql://user:password@localhost:5432/agent_study

# ===== Vector Store (可选) =====
CHROMA_PERSIST_PATH=./data/chroma
