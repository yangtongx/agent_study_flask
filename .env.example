# ===== LLM (DeepSeek) =====
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# ===== Agent =====
AGENT_MAX_ITERATIONS=10
AGENT_MEMORY_WINDOW=20
AGENT_DEBUG=true

# ===== Database (PostgreSQL) =====
PG_URI=postgresql://user:password@localhost:5432/agent_study

# ===== Vector Store (可选) =====
CHROMA_PERSIST_PATH=./data/chroma
